extends SceneTree
const SkillUpgradeDefs = preload("res://Scripts/Player/SkillUpgradeDefs.gd")
func _init():
 var s = RunProgressionState.new()
 s.reset(100)
 assert(s.get_skill_refreshes() == 3)
 assert(s.small_skill_variant == &"rush_order")
 s.queue_skill_upgrade_for_completed_day(1)
 assert(s.has_pending_skill_upgrade())
 assert(s.get_pending_skill_upgrade_kind() == &"small")
 var opts = SkillUpgradeDefs.draw_three(&"small", s.small_skill_variant)
 assert(opts.size() == 3)
 assert(s.apply_skill_upgrade(&"small", StringName(opts[0].id)))
 assert(not s.has_pending_skill_upgrade())
 s.queue_skill_upgrade_for_completed_day(3)
 assert(s.get_pending_skill_upgrade_kind() == &"big")
 assert(s.spend_skill_refresh())
 var snapshot: Dictionary = s.get_snapshot()
 var restored := RunProgressionState.new()
 restored.apply_snapshot(snapshot)
 assert(restored.small_skill_variant == s.small_skill_variant)
 assert(restored.big_skill_variant == s.big_skill_variant)
 assert(restored.get_skill_refreshes() == s.get_skill_refreshes())
 print("skill upgrade state validation passed")
 quit()
